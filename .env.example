# ═══════════════════════════════════════════════════════
# TATADANA ENVIRONMENT CONFIGURATION (.env.example)
# Jangan hardcode secrets di source code!
# ═══════════════════════════════════════════════════════

# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Backend Base URL (digunakan untuk registrasi setWebhook Telegram)
WEBHOOK_BASE_URL="https://tatadana.id"
NEXT_PUBLIC_APP_URL="https://tatadana.id"

# Supabase Credentials (PostgreSQL & Supabase Auth)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Storage Bucket (untuk menyimpan hasil export PDF & Excel)
SUPABASE_STORAGE_BUCKET="tatadana-exports"

# AI Provider API Keys (Dapat dikonfigurasi & dienkripsi via Admin Dashboard)
GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY="sk-proj-..."
DEEPSEEK_API_KEY="sk-..."

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
MIDTRANS_CLIENT_KEY="SB-Mid-client-..."
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-..."
MIDTRANS_IS_PRODUCTION="false"

# Security & Encryption Key (32-character hex key untuk enkripsi token di DB)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
